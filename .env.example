# Postgres connection string.
# Local (docker compose): postgres://postgres:postgres@localhost:5434/suphomey
# Neon: use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5434/suphomey

# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Any long random string; set the same value in the Vercel project settings.
CRON_SECRET=

# Optional. Only needed to geocode HDB blocks that are not yet in data/seed (see docs/DATA.md).
ONEMAP_TOKEN=
