# Postgres connection string.
# Local (docker compose): postgres://postgres:postgres@localhost:5434/suphomey
# Neon: use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5434/suphomey

# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Any long random string; set the same value in the Vercel project settings.
CRON_SECRET=

# Optional. Your OneMap API account (register at https://www.onemap.gov.sg/apidocs/register).
# Only used by `pnpm locate-blocks` and `pnpm build-seed` to geocode blocks and schools not yet in
# data/seed/onemap-cache.csv (see docs/DATA.md). Tokens last 72 hours; a new one is requested
# automatically before expiry. Without these, OneMap is called unauthenticated and rate limits hard.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
